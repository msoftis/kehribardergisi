# ==============================================================================
# KEHRİBAR MEDYA - APACHE .HTACCESS YAPILANDIRMASI
# .html uzantısını gizleme, temiz URL (Clean URLs) ve SEO optimizasyonu
# ==============================================================================

# 1. YENİDEN YAZMA MOTORU (MOD_REWRITE)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # HTTPS Yönlendirmesi (Canlı sunucuda SSL aktif ise yorumu kaldırabilirsiniz):
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # index veya index.html isteklerini doğrudan kök dizine (/) 301 ile yönlendir
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.html)?[\s\?] [NC]
    RewriteRule ^index(\.html)?$ / [R=301,L]

    # Tarayıcıda veya arama motorlarında .html ile çağrılan sayfaları .html'siz temiz URL'ye 301 yönlendir
    # Örn: site.com/sayfa.html -> site.com/sayfa
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.html[\s?] [NC]
    RewriteRule ^ %1 [R=301,L,NE]

    # .html uzantısız gelen isteklerin arkasında ilgili .html dosyası varsa sessizce arka planda çalıştır
    # Örn: site.com/sayfa çağrıldığında arka planda sayfa.html yüklenir ama URL temiz kalır
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

# 2. VARSAYILAN BAŞLANGIÇ DOSYASI
DirectoryIndex index.html

# 3. KARAKTER KODLAMASI (UTF-8)
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .svg .json

# 4. GÜVENLİK AYARLARI (Gizli dosyaları ve dizin listelemeyi engelle)
Options -Indexes

<FilesMatch "^\.(htaccess|htpasswd|git|env)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 5. GZIP & DEFLATE İLE SIKIŞTIRMA (Hızlı Sayfa Yükleme)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 6. TARAYICI ÖNBELLEKLEME (BROWSER CACHING)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# 7. GÜVENLİK VE SAYFA DENEYİMİ BAŞLIKLARI (PAGE EXPERIENCE & SEO)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
